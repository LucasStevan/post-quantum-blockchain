{
	"name": "PQC Node",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"args": {
			"LIBOQS_VERSION": "0.14.0"
		}
	},
	"containerEnv": {
		"OQS_INSTALL_PATH": "/usr/local",
		"LD_LIBRARY_PATH": "/usr/local/lib",
		"PYOQS_VERSION": "0.14.0"
	},
	"remoteUser": "root",
	"forwardPorts": [8000, 8001, 8002, 8100, 8101, 8102],
	"postCreateCommand": "python -m py_compile Quantum.py generate_genesis.py && python -m unittest discover -s tests",
	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python"]
		}
	}
}
